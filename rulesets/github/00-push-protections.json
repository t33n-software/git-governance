{
  "name": "push-protections: secret artifact boundary",
  "target": "push",
  "source": "t33n-software",
  "enforcement": "active",
  "conditions": {
    "repository_property": {
      "include": [
        {
          "name": "visibility",
          "property_values": [
            "private",
            "internal"
          ],
          "source": "system"
        }
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": [
          "*.pem",
          "*.key",
          "*.p12",
          "*.pfx",
          "*.jks",
          "*.keystore",
          "*.kdbx",
          "*.ppk",
          "*.gpg"
        ]
      }
    },
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          "**/.env",
          "**/.env.*",
          "**/.envrc",
          "**/credentials",
          "**/credentials.*",
          "**/*.tfstate",
          "**/*.tfstate.*"
        ]
      }
    }
  ],
  "bypass_actors": []
}
