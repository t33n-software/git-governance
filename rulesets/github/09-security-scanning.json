{
  "name": "security-scanning: shared lines (security-scanning=enabled)",
  "target": "branch",
  "source": "t33n-software",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/develop",
        "refs/heads/release/*",
        "refs/heads/support/*"
      ],
      "exclude": []
    },
    "repository_property": {
      "include": [
        {
          "name": "security-scanning",
          "property_values": [
            "enabled"
          ],
          "source": "custom"
        }
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Dependency review / Dependency admission review"
          }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "alerts_threshold": "all",
            "security_alerts_threshold": "all"
          }
        ]
      }
    }
  ]
}
