{
  "name": "branch-governance: release shared lines (quality-gates=linux-only)",
  "target": "branch",
  "source": "t33n-software",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/release/*"
      ],
      "exclude": []
    },
    "repository_property": {
      "include": [
        {
          "name": "quality-gates",
          "property_values": [
            "linux-only"
          ],
          "source": "custom"
        }
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          {
            "context": "Quality gates / linux-amd64"
          },
          {
            "context": "Dependency review / Dependency admission review"
          }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "alerts_threshold": "all",
            "security_alerts_threshold": "all"
          }
        ]
      }
    }
  ]
}
